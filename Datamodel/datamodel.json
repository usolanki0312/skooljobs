{
  "database": "skooljobs_db",

  "collections": {
    "users": {
      "_schema": {
        "_id": "ObjectId — MongoDB primary key (auto-generated)",
        "user_id": "string — e.g. USR-0001. Stable human-readable ID used as cross-collection reference.",
        "email": "string — Unique login email",
        "password_hash": "string — bcrypt hashed password",
        "role": "enum — ['teacher', 'school_principal', 'school_admin', 'school_hr', 'skooljobs_admin', 'skooljobs_superadmin']",
        "school_id": "string — e.g. SCH-0001. Set for all school-side roles; null for teacher and platform admin.",
        "profile_id": "string — user_id (teachers) or school_id (school roles). Null until profile is created.",
        "phone": "string",
        "is_active": "boolean — Platform-level enable/disable (controlled by skooljobs_admin)",
        "is_email_verified": "boolean",
        "is_phone_verified": "boolean",
        "last_login": "Date | null",
        "password_reset_token": "string | null",
        "password_reset_expires": "Date | null",
        "created_at": "Date",
        "updated_at": "Date"
      },
      "_indexes": [
        { "fields": { "email": 1 }, "options": { "unique": true } },
        { "fields": { "user_id": 1 }, "options": { "unique": true } },
        { "fields": { "school_id": 1 } }
      ]
    },

    "teacher_profiles": {
      "_schema": {
        "_id": "ObjectId",
        "user_id": "string — e.g. USR-0001",
        "title": "enum — ['Mr','Mrs','Miss','Ms','Dr','Prof']",
        "first_name": "string",
        "middle_name": "string | null",
        "last_name": "string",
        "dob": "object — { day: string, month: string, year: string }",
        "age": "number | null — Auto-calculated from DOB",
        "nationality": "string",
        "current_job_title": "string | null — e.g. 'Mathematics Teacher'",
        "main_subject": "string — e.g. 'Mathematics'",
        "additional_subjects": "string[] — e.g. ['History','Geography']",
        "classes_taught": "string[] — e.g. ['Class 10','Class 12']",
        "languages": "object[] — [{ language: string, proficiency: string }]",
        "highest_qualification_1": "string | null",
        "highest_qualification_2": "string | null",
        "profile_photo_url": "string | null",
        "profile_score": "number — 0–100, computed from filled sections",
        "is_available": "boolean — Teacher is actively looking for jobs",
        "profile_status": "enum — ['active','inactive','suspended','pending_verification']",
        "admin_verified": "boolean — Profile reviewed and cleared by SkoolJobs admin",
        "created_at": "Date",
        "updated_at": "Date",

        "qualifications": {
          "_type": "object[]",
          "_item_schema": {
            "_id": "ObjectId",
            "class_level": "enum | null — ['Class 10','Class 12']",
            "school_name": "string | null",
            "degree": "string — e.g. 'B.Ed', 'M.Sc'",
            "course": "string | null",
            "year_passed": "string",
            "medium": "string | null",
            "mode": "enum | null — ['Regular','Distance','Part-time','Online','Correspondence','Open University','Hybrid']",
            "percentage": "string | null",
            "university": "string | null",
            "college": "string | null",
            "created_at": "Date",
            "updated_at": "Date"
          }
        },

        "experiences": {
          "_type": "object[]",
          "_item_schema": {
            "_id": "ObjectId",
            "school_name": "string",
            "is_current_employer": "boolean",
            "board": "string | null",
            "start_date": "Date",
            "end_date": "Date | null",
            "main_subject": "string",
            "other_subjects": "string | null",
            "post_held": "string",
            "salary_ctc_annual": "number | null",
            "monthly_take_home": "number | null",
            "reason_for_leaving": "string | null",
            "details": "string | null",
            "created_at": "Date",
            "updated_at": "Date"
          }
        },

        "achievements": {
          "_type": "object[]",
          "_item_schema": {
            "_id": "ObjectId",
            "category": "enum — ['award','course']",
            "type": "string — 'Award','Recognition','Publication' | 'Workshop','Certification','Training'",
            "name": "string",
            "issued_by": "string",
            "year": "string",
            "created_at": "Date"
          }
        },

        "resumes": {
          "_type": "object[]",
          "_item_schema": {
            "_id": "ObjectId",
            "resume_id": "string — e.g. RES-0001",
            "source": "enum — ['uploaded','created']",
            "title": "string",
            "file_name": "string",
            "file_url": "string | null",
            "format": "enum — ['PDF','DOCX','Text']",
            "skill": "string | null — used for job-match recommendation",
            "score": "number — 0–100",
            "full_name": "string | null",
            "email": "string | null",
            "mobile": "string | null",
            "address": "string | null",
            "current_job_title": "string | null",
            "summary": "string | null",
            "skills": "string | null",
            "education": "string | null",
            "experience": "string | null",
            "certifications": "string | null",
            "languages": "string | null",
            "resume_achievements": "string | null",
            "notes": "string | null",
            "is_active": "boolean",
            "created_at": "Date",
            "updated_at": "Date"
          }
        },

        "cover_letters": {
          "_type": "object[]",
          "_item_schema": {
            "_id": "ObjectId",
            "cover_letter_id": "string — e.g. CL-0001",
            "job_id": "string | null — e.g. JOB-0001",
            "resume_id": "string | null — e.g. RES-0001",
            "source": "enum — ['ai_generated','uploaded','manual']",
            "content": "string",
            "file_name": "string | null",
            "file_url": "string | null",
            "created_at": "Date"
          }
        },

        "saved_jobs": {
          "_type": "object[]",
          "_item_schema": {
            "_id": "ObjectId",
            "job_id": "string — e.g. JOB-0001",
            "saved_at": "Date"
          }
        }
      },
      "_indexes": [
        { "fields": { "user_id": 1 }, "options": { "unique": true } },
        { "fields": { "profile_status": 1 } },
        {
          "fields": { "resumes.skill": 1 },
          "comment": "Multikey index for job-match recommendation queries"
        }
      ]
    },

    "school_profiles": {
      "_schema": {
        "_id": "ObjectId",
        "school_id": "string — e.g. SCH-0001",
        "primary_user_id": "string — user_id of the user who first registered the school (e.g. USR-0001)",
        "school_name": "string",
        "sector": "enum — ['Schools & Institutions','Colleges & Universities','Coaching Centers','EdTech','Government','Private','Other']",
        "school_type": "enum — ['Public School','Private School','International School','Boarding School','Co-Ed School','Girls School','Boys School','Special Education School','Other']",
        "affiliation_status": "enum — ['Affiliated','Pending Affiliation','Not Affiliated']",
        "board": "enum — ['CBSE','ICSE','State Board','IB','IGCSE / Cambridge','NIOS','Other']",
        "medium": "string — Medium of instruction (English/Hindi/etc.)",
        "level": "enum — ['Primary','Middle','Secondary','Senior Secondary','All Levels']",
        "industry": "string",
        "total_teachers": "number | null",
        "established_year": "number | null",
        "description": "string | null",
        "logo_url": "string | null",
        "cover_image_url": "string | null",
        "contact": {
          "email": "string",
          "phone": "string",
          "website": "string | null"
        },
        "address": {
          "pin_code": "string",
          "city": "string",
          "state": "string",
          "country": "string",
          "full_address": "string | null"
        },
        "social_links": {
          "linkedin": "string | null",
          "facebook": "string | null",
          "twitter": "string | null",
          "instagram": "string | null"
        },
        "profile_status": "enum — ['active','pending_verification','suspended','rejected']",
        "admin_verified": "boolean — School KYC cleared by SkoolJobs admin",
        "admin_notes": "string | null — Internal notes from admin review",
        "created_at": "Date",
        "updated_at": "Date"
      },
      "_indexes": [
        { "fields": { "school_id": 1 }, "options": { "unique": true } },
        { "fields": { "school_name": 1 } },
        { "fields": { "profile_status": 1 } },
        { "fields": { "address.city": 1 } }
      ]
    },

    "jobs": {
      "_schema": {
        "_id": "ObjectId",
        "job_id": "string — e.g. JOB-0001",
        "school_id": "string — e.g. SCH-0001",
        "posted_by_user_id": "string — user_id of HR/Admin who created the job (e.g. USR-0002)",
        "title": "string — e.g. 'Mathematics Teacher'",
        "subject": "string — Subject to teach",
        "experience_required": "string — e.g. '2-5 Years'",
        "CTC_per_year": "String | null",
        "Monthly Take Home": "String | null",
        "location": "string",
        "employment_type": "enum — ['Full-time','Part-time','Contract','Visiting','Internship']",
        "description": "string | null — Full job description",
        "requirements": "string | null — Key requirements",
        "qualifications_required": "string | null",
        "vacancies": "number — Number of open positions",
        "admin_review_status": "enum — ['pending_review','published','rejected','unpublished']",
        "status": "enum — ['draft','active','closed','expired']",
        "admin_rejection_reason": "string | null",
        "applicants_count": "number — Denormalized counter, incremented on each new application",
        "posted_date": "Date | null — Set when admin publishes the job",
        "expiry_date": "Date | null — Auto-close date",
        "created_at": "Date",
        "updated_at": "Date"
      },
      "_indexes": [
        { "fields": { "job_id": 1 }, "options": { "unique": true } },
        { "fields": { "school_id": 1 } },
        { "fields": { "status": 1 } },
        { "fields": { "location": 1 } },
        { "fields": { "employment_type": 1 } }
      ]
    },

    "applications": {
      "_schema": {
        "_id": "ObjectId",
        "application_id": "string — e.g. APP-0001",
        "job_id": "string — e.g. JOB-0001",
        "teacher_user_id": "string — user_id of the applying teacher (e.g. USR-0001)",
        "school_id": "string — e.g. SCH-0001 (denormalized for fast school-side queries)",
        "resume_id": "string | null — e.g. RES-0001",
        "cover_letter_id": "string | null",
        "status": "enum — ['submitted','viewed_by_school','shortlisted','rejected_by_school','hired','withdrawn']",
        "school_notes": "string | null — Private note by school HR",
        "admin_override": {
          "action": "enum | null — ['approved','rejected','flagged']",
          "admin_user_id": "string | null — user_id of the admin who actioned (e.g. USR-0004)",
          "notes": "string | null",
          "actioned_at": "Date | null"
        },
        "submitted_at": "Date",
        "updated_at": "Date"
      },
      "_indexes": [
        { "fields": { "application_id": 1 }, "options": { "unique": true } },
        { "fields": { "job_id": 1 } },
        { "fields": { "teacher_user_id": 1 } },
        { "fields": { "school_id": 1 } },
        { "fields": { "status": 1 } },
        {
          "fields": { "job_id": 1, "teacher_user_id": 1 },
          "options": {
            "unique": true,
            "comment": "Prevent duplicate applications"
          }
        }
      ]
    },

    "activity_logs": {
      "_schema": {
        "_id": "ObjectId",
        "user_id": "string — user_id of the actor (e.g. USR-0001)",
        "role": "string — Role at time of action",
        "action_type": "enum — ['applied','saved_job','viewed_job','unsaved_job','profile_updated','profile_photo_updated','resume_uploaded','resume_created','resume_deleted','cover_letter_generated','logged_in','logged_out','job_posted','job_draft_saved','job_published','applicant_shortlisted','applicant_rejected','candidate_saved','subscription_purchased']",
        "description": "string — e.g. 'Applied for Mathematics Teacher at Green Valley School'",
        "metadata": {
          "job_id": "string | null",
          "application_id": "string | null",
          "school_id": "string | null",
          "teacher_user_id": "string | null",
          "resume_id": "string | null"
        },
        "created_at": "Date"
      },
      "_indexes": [
        { "fields": { "user_id": 1 } },
        { "fields": { "action_type": 1 } },
        { "fields": { "created_at": -1 } }
      ]
    }
  }
}
